/* pages/train_query/train_query.wxss */
.container {
    padding: 20rpx;
    min-height: 100vh;
    background-color: #f5f5f5;
}

/* ... 其他样式保持不变 ... */

.buy-btn {
    background: linear-gradient(135deg, #4caf50, #45a049);
    color: white;
    padding: 12rpx 25rpx;
    border-radius: 20rpx;
    font-size: 26rpx;
    /* 确保按钮可以点击 */
    position: relative;
    z-index: 10;
}

/* 防止事件冒泡的样式 */
.train-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 20rpx;
    border-top: 1rpx solid #e0e0e0;
    position: relative;
    z-index: 1;
}

/* 防止点击车次项时触发预订按钮的事件 */
.train-item {
    position: relative;
}

/* 确保预订按钮点击区域 */
.buy-btn:active {
    background: linear-gradient(135deg, #45a049, #4caf50);
    opacity: 0.9;
}

.container {
    padding: 20rpx;
    min-height: 100vh;
    background-color: #f5f5f5;
}

.query-section {
    background: white;
    border-radius: 16rpx;
    padding: 30rpx;
    margin-bottom: 30rpx;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.query-form {
    display: flex;
    flex-direction: column;
    gap: 30rpx;
}

.station-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 25rpx 20rpx;
    border: 2rpx solid #e0e0e0;
    border-radius: 10rpx;
    background-color: #f9f9f9;
}

.station-item:active {
    background-color: #f0f0f0;
}

.station-label {
    font-size: 28rpx;
    color: #666;
}

.station-value {
    font-size: 30rpx;
    color: #333;
    font-weight: 500;
    flex: 1;
    text-align: center;
}

.icon-arrow {
    color: #999;
    font-size: 24rpx;
}

.exchange-btn {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 60rpx;
}

.exchange-icon {
    font-size: 36rpx;
    color: #4caf50;
    background: #e8f5e8;
    padding: 10rpx 20rpx;
    border-radius: 50%;
}

.query-btn {
    background: linear-gradient(135deg, #4caf50, #45a049);
    color: white;
    border: none;
    border-radius: 10rpx;
    padding: 25rpx;
    font-size: 32rpx;
    font-weight: bold;
    margin-top: 20rpx;
}

.query-btn:active {
    background: linear-gradient(135deg, #45a049, #4caf50);
    opacity: 0.9;
}

/* 车站选择模态框样式 */
.station-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1000;
}

.modal-mask {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
}

.modal-content {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    background: white;
    border-radius: 20rpx 20rpx 0 0;
    max-height: 70vh;
    display: flex;
    flex-direction: column;
}

.modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30rpx;
    border-bottom: 1rpx solid #e0e0e0;
}

.modal-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
}

.modal-close {
    font-size: 40rpx;
    color: #999;
    padding: 10rpx 20rpx;
}

.station-list {
    flex: 1;
    height: 400rpx;
}

.station-item-list {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 25rpx 30rpx;
    border-bottom: 1rpx solid #f0f0f0;
}

.station-item-list:active {
    background-color: #f9f9f9;
}

.station-name {
    font-size: 30rpx;
    color: #333;
}

.station-city {
    font-size: 24rpx;
    color: #999;
    background: #f0f0f0;
    padding: 6rpx 15rpx;
    border-radius: 20rpx;
}

/* 查询结果区域 */
.result-section {
    background: white;
    border-radius: 16rpx;
    padding: 30rpx;
    margin-bottom: 30rpx;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.result-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 30rpx;
    padding-bottom: 20rpx;
    border-bottom: 1rpx solid #f0f0f0;
}

.train-list {
    display: flex;
    flex-direction: column;
    gap: 30rpx;
}

.train-item {
    background: #f9f9f9;
    border-radius: 12rpx;
    padding: 25rpx;
    border-left: 6rpx solid #4caf50;
}

.train-item:active {
    background: #f0f0f0;
}

.train-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20rpx;
}

.train-number {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
}

.train-type {
    font-size: 24rpx;
    color: #4caf50;
    background: #e8f5e8;
    padding: 6rpx 15rpx;
    border-radius: 20rpx;
}

.train-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20rpx;
}

.station-time {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
}

.time {
    font-size: 30rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 8rpx;
}

.station {
    font-size: 24rpx;
    color: #666;
}

.duration {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 20rpx;
}

.duration-text {
    font-size: 22rpx;
    color: #999;
    margin-bottom: 8rpx;
}

.duration-line {
    color: #ccc;
}

.train-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 20rpx;
    border-top: 1rpx solid #e0e0e0;
}

.price-label {
    font-size: 24rpx;
    color: #666;
}

.price-value {
    font-size: 28rpx;
    font-weight: bold;
    color: #f44336;
}

.buy-btn {
    background: linear-gradient(135deg, #4caf50, #45a049);
    color: white;
    padding: 12rpx 25rpx;
    border-radius: 20rpx;
    font-size: 26rpx;
}

/* 空状态样式 */
.empty-state {
    text-align: center;
    padding: 100rpx 30rpx;
    background: white;
    border-radius: 16rpx;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.empty-icon {
    font-size: 80rpx;
    display: block;
    margin-bottom: 30rpx;
}

.empty-text {
    display: block;
    font-size: 32rpx;
    color: #333;
    margin-bottom: 15rpx;
}

.empty-tip {
    display: block;
    font-size: 26rpx;
    color: #999;
}

/* 在train_query.wxss中添加样式2025年12月5日10点24分 */
.user-info-bar {
    background: linear-gradient(135deg, #4caf50, #45a049);
    color: white;
    padding: 20rpx 30rpx;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30rpx;
    border-radius: 10rpx;
}

.user-name {
    font-size: 28rpx;
    font-weight: bold;
}

.user-no {
    font-size: 24rpx;
    opacity: 0.9;
}

.logout-btn {
    font-size: 26rpx;
    padding: 10rpx 20rpx;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 20rpx;
}