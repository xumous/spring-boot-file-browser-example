/* pages/login/login.wxss */
.login-container {
    min-height: 100vh;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 40rpx;
}

.login-form {
    background: white;
    border-radius: 20rpx;
    padding: 60rpx 50rpx;
    width: 100%;
    max-width: 600rpx;
    box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.1);
}

.logo-section {
    text-align: center;
    margin-bottom: 60rpx;
}

.logo-icon {
    font-size: 80rpx;
    display: block;
    margin-bottom: 20rpx;
}

.logo-text {
    font-size: 36rpx;
    font-weight: bold;
    color: #333;
    display: block;
    margin-bottom: 10rpx;
}

.welcome-text {
    font-size: 28rpx;
    color: #666;
    display: block;
}

.form-group {
    margin-bottom: 40rpx;
}

.form-label {
    display: block;
    font-size: 28rpx;
    color: #333;
    margin-bottom: 15rpx;
    font-weight: 500;
}

.form-input {
    border: 2rpx solid #e0e0e0;
    border-radius: 10rpx;
    padding: 25rpx 20rpx;
    font-size: 28rpx;
    background-color: #f9f9f9;
    transition: border-color 0.3s;
}

.form-input:focus {
    border-color: #4caf50;
    background-color: white;
}

.remember-me {
    display: flex;
    align-items: center;
    margin-bottom: 40rpx;
}

.remember-text {
    font-size: 26rpx;
    color: #666;
    margin-left: 15rpx;
}

.login-btn {
    background: linear-gradient(135deg, #4caf50, #45a049);
    color: white;
    border: none;
    border-radius: 10rpx;
    padding: 25rpx;
    font-size: 32rpx;
    font-weight: bold;
    margin-bottom: 40rpx;
    transition: all 0.3s;
}

.login-btn.loading {
    opacity: 0.7;
}

.login-btn:not(.loading):active {
    background: linear-gradient(135deg, #45a049, #4caf50);
    transform: translateY(2rpx);
}

.register-link {
    text-align: center;
    font-size: 26rpx;
    color: #666;
}

.link-text {
    color: #4caf50;
    margin-left: 10rpx;
    font-weight: 500;
}

.link-text:active {
    opacity: 0.8;
}

.footer {
    margin-top: 60rpx;
    text-align: center;
}

.footer-text {
    font-size: 24rpx;
    color: rgba(255, 255, 255, 0.8);
}