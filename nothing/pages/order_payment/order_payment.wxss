/* pages/order_payment/order_payment.wxss */
.page-scroll {
    height: 100vh;
    background-color: #f5f5f5;
}

.container {
    padding: 20rpx;
    padding-bottom: 150rpx;
    min-height: 100vh;
    box-sizing: border-box;
}

/* 订单信息样式 */
.order-section {
    background: white;
    border-radius: 16rpx;
    padding: 30rpx;
    margin-bottom: 30rpx;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.order-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20rpx;
    padding-bottom: 20rpx;
    border-bottom: 1rpx solid #f0f0f0;
}

.order-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
}

.order-timeout {
    font-size: 24rpx;
    color: #f44336;
    font-weight: bold;
    background: #ffebee;
    padding: 8rpx 16rpx;
    border-radius: 6rpx;
}

.order-detail {
    margin-bottom: 30rpx;
}

.detail-item {
    display: flex;
    margin-bottom: 15rpx;
    align-items: flex-start;
}

.detail-label {
    width: 140rpx;
    font-size: 26rpx;
    color: #666;
    flex-shrink: 0;
}

.detail-value {
    flex: 1;
    font-size: 26rpx;
    color: #333;
    font-weight: 500;
    word-break: break-all;
}

.order-amount {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 20rpx;
    border-top: 1rpx solid #e0e0e0;
}

.amount-label {
    font-size: 28rpx;
    color: #333;
    font-weight: bold;
}

.amount-value {
    font-size: 40rpx;
    color: #f44336;
    font-weight: bold;
}

/* 支付方式样式 */
.payment-section {
    background: white;
    border-radius: 16rpx;
    padding: 30rpx;
    margin-bottom: 30rpx;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.section-title {
    font-size: 28rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 20rpx;
}

.payment-methods {
    display: flex;
    flex-direction: column;
    gap: 20rpx;
}

.method-item {
    display: flex;
    align-items: center;
    padding: 25rpx;
    border: 2rpx solid #e0e0e0;
    border-radius: 10rpx;
    background: #f9f9f9;
}

.method-item.active {
    border-color: #4caf50;
    background: #e8f5e8;
}

.method-item:active {
    background: #f0f0f0;
}

.method-icon {
    width: 60rpx;
    height: 60rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 36rpx;
    margin-right: 20rpx;
    border-radius: 50%;
}

.method-icon.wechat {
    color: white;
    background: #09bb07;
}

.method-icon.alipay {
    color: white;
    background: #1296db;
}

.method-name {
    flex: 1;
    font-size: 28rpx;
    color: #333;
    font-weight: 500;
}

.method-select {
    font-size: 32rpx;
    color: #4caf50;
    font-weight: bold;
}

/* 协议样式 */
.agreement-section {
    display: flex;
    align-items: center;
    margin-bottom: 30rpx;
    padding: 0 20rpx;
}

.agreement-text {
    font-size: 24rpx;
    color: #666;
    margin-left: 10rpx;
}

/* 底部操作栏样式 */
.action-bar {
    background: white;
    border-radius: 16rpx;
    padding: 30rpx;
    margin: 0 20rpx;
    box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.08);
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 100;
}

.action-left {
    flex: 1;
}

.total-label {
    font-size: 28rpx;
    color: #666;
}

.total-value {
    font-size: 36rpx;
    color: #f44336;
    font-weight: bold;
    margin-left: 10rpx;
}

.action-right {
    display: flex;
    gap: 20rpx;
}

.cancel-btn,
.pay-btn {
    padding: 25rpx 40rpx;
    font-size: 30rpx;
    font-weight: bold;
    border: none;
    border-radius: 10rpx;
    min-width: 180rpx;
}

.cancel-btn {
    background: #f0f0f0;
    color: #666;
}

.cancel-btn:active {
    background: #e0e0e0;
}

.pay-btn {
    background: linear-gradient(135deg, #4caf50, #45a049);
    color: white;
}

.pay-btn:active {
    background: linear-gradient(135deg, #45a049, #4caf50);
    opacity: 0.9;
}

.pay-btn.paying {
    background: #e0e0e0;
    color: #999;
}