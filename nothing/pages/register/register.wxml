<!--pages/register/register.wxml-->
<view class="register-container">
    <!-- 注册表单 -->
    <view class="register-form">
        <view class="logo-section">
            <text class="logo-icon">🚄</text>
            <text class="logo-text">注册新账号</text>
            <text class="welcome-text">填写以下信息完成注册</text>
        </view>

        <view class="form-group">
            <text class="form-label">学号</text>
            <input bindinput="inputStuNo" class="form-input" maxlength="20" placeholder="请输入学号（纯数字）"
                   type="number"
                   value="{{stu_no}}"/>
        </view>

        <view class="form-group">
            <text class="form-label">密码</text>
            <input bindinput="inputStuPwd" class="form-input" maxlength="20" password
                   placeholder="请输入密码（至少6位）"
                   value="{{stu_pwd}}"/>
        </view>

        <view class="form-group">
            <text class="form-label">确认密码</text>
            <input bindinput="inputStuPwdConfirm" class="form-input" maxlength="20" password
                   placeholder="请再次输入密码" value="{{stu_pwd_confirm}}"/>
        </view>

        <view class="form-group">
            <text class="form-label">姓名</text>
            <input bindinput="inputStuName" class="form-input" maxlength="20" placeholder="请输入真实姓名"
                   value="{{stu_name}}"/>
        </view>

        <view class="form-group">
            <text class="form-label">电话</text>
            <input bindinput="inputStuTelephone" class="form-input" maxlength="11" placeholder="请输入手机号"
                   type="number" value="{{stu_telephone}}"/>
        </view>

        <button bindtap="register" class="register-btn {{loading ? 'loading' : ''}}" disabled="{{loading}}">
            {{loading ? '注册中...' : '注册'}}
        </button>

        <view class="login-link">
            <text bindtap="goBackToLogin" class="link-text">返回登录</text>
        </view>
    </view>
</view>